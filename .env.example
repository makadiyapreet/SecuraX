# SecuraX Environment Variables
# Copy this file to .env and insert your real keys.
# NEVER commit .env to source control!

# Groq API Key (Primary)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_primary_key_here

# Optional: Fallback API Key (Automatic failover if primary key quota/rate limit is exhausted)
# When the primary key hits a 429 RateLimit or exhausts credits, requests instantly transfer to this fallback key
GROQ_API_KEY_FALLBACK=your_secondary_key_here

# Alternatively, you can specify multiple comma-separated keys:
# GROQ_API_KEYS=key1,key2,key3

# Optional: Override default model (defaults to config/refinement.yaml)
# Available models: qwen/qwen3.8-27b, openai/gpt-oss-120b
# GROQ_MODEL=qwen/qwen3.8-27b
